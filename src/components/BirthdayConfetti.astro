---
const colors = ["#e9b949", "#e87b72", "#54a899", "#a28bd4", "#699ed5"];
const pieces = Array.from({ length: 72 }, (_, index) => ({
  left: (index * 37) % 100,
  drift: ((index * 53) % 240) - 120,
  delay: ((index * 13) % 80) / 100,
  duration: 2.8 + ((index * 17) % 90) / 100,
  rotation: ((index * 71) % 720) - 360,
  color: colors[index % colors.length],
  round: index % 4 === 0,
}));
---

<div class="birthday-confetti" aria-hidden="true">
  {
    pieces.map((piece) => (
      <span
        class:list={["confetti-piece", { round: piece.round }]}
        style={{
          left: `${piece.left}%`,
          "--drift": `${piece.drift}px`,
          "--delay": `${piece.delay}s`,
          "--duration": `${piece.duration}s`,
          "--rotation": `${piece.rotation}deg`,
          background: piece.color,
        }}
      />
    ))
  }
</div>

<style>
  .birthday-confetti {
    position: fixed;
    inset: 0;
    z-index: 50;
    overflow: hidden;
    pointer-events: none;
  }

  .confetti-piece {
    position: absolute;
    top: -20px;
    width: 7px;
    height: 12px;
    border-radius: 1px;
    opacity: 0;
    animation: confetti-fall var(--duration) var(--delay) linear both;
  }

  .confetti-piece.round {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  @keyframes confetti-fall {
    0% {
      opacity: 0;
      transform: translate3d(0, 0, 0) rotate(0deg);
    }
    8%,
    65% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: translate3d(var(--drift), calc(100dvh + 40px), 0)
        rotate(var(--rotation)) rotateY(540deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .birthday-confetti {
      display: none;
    }

    .confetti-piece {
      animation: none;
    }
  }
</style>
