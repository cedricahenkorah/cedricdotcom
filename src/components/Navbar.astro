---
import ThemeIcon from "./ThemeIcon.astro";
const { pathname } = Astro.url;
const links = [
  { href: "/", label: "home", active: pathname === "/" },
  {
    href: "/notes",
    label: "notes",
    active: pathname.startsWith("/notes") || pathname.startsWith("/posts/"),
  },
  {
    href: "/projects",
    label: "projects",
    active: pathname.startsWith("/projects"),
  },
  { href: "/now", label: "now", active: pathname === "/now" },
];
const visibleLinks = pathname === "/" ? links.filter((link) => link.href === "/") : links;
---

<header class="site-header shell">
  <nav aria-label="Main navigation">
    {
      visibleLinks.map((link) => (
        <a href={link.href} aria-current={link.active ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <ThemeIcon />
</header>
