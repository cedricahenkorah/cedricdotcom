---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import portrait from "../assets/cedric-portrait.jpg";
---

<Layout title="cedric ahenkorah" showFooter={false}>
  <main id="main" class="shell">
    <section class="intro" aria-labelledby="intro-title">
      <div class="intro-copy">
        <div class="intro-identity">
          <h1 id="intro-title">
            cedric ahenkorah
            <span class="ghana-flag" role="img" aria-label="Ghana">🇬🇭</span>
          </h1>
        </div>
        <p>
          dreamer, creator and minimalist. spending much of my time talking to
          computers and building meaningful software that people love :).
        </p>
      </div>
      <Image
        src={portrait}
        alt="cedric ahenkorah"
        width={320}
        height={400}
        fit="cover"
        position="bottom"
        loading="eager"
        class="portrait"
      />
    </section>
    <nav class="home-destinations" aria-label="Explore my work">
      <a href="/notes">Notes</a>
      <a href="/projects">Projects</a>
      <a href="/now">now</a>
      <a href="/links">links</a>
    </nav>
  </main>
</Layout>
