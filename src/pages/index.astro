---
import Layout from "../layouts/Layout.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { Image } from "astro:assets";
import portrait from "../assets/cedric-portrait.jpg";
---

<Layout title="cedric ahenkorah" showFooter={false}>
  <main id="main" class="shell">
    <section class="intro" aria-labelledby="intro-title">
      <div class="intro-copy">
        <div class="intro-identity">
          <h1 id="intro-title">
            cedric ahenkorah
            <span class="ghana-flag" role="img" aria-label="Ghana">🇬🇭</span>
          </h1>
        </div>
        <p>
          dreamer, creator and minimalist. spending much of my time talking to
          computers and building meaningful software that people love :).
        </p>
        <nav class="intro-links" aria-label="Connect with Cedric">
          <a
            class="text-link"
            href="https://docs.google.com/document/d/16sO2OGTOtqvGN31PrdH4MBD91i4cZCQ7wuAypdrbG7Q/edit?usp=sharing"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Resume (opens in a new tab)">Resume</a
          >
          <SocialLinks />
        </nav>
      </div>
      <Image
        src={portrait}
        alt="cedric ahenkorah"
        width={320}
        height={400}
        fit="cover"
        position="bottom"
        loading="eager"
        class="portrait"
      />
    </section>
    <nav class="home-destinations" aria-label="Explore my work">
      <a href="/notes">Notes</a>
      <a href="/projects">Projects</a>
      <a href="/now">now</a>
    </nav>
  </main>
</Layout>
