---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found — cedric ahenkorah"
  description="This page could not be found. Explore Cedric’s notes or return home."
>
  <main id="main" class="shell">
    <header class="page-intro">
      <p class="error-code">404</p>
      <h1>Page not found</h1>
      <p>The link may be old, or the page may have moved.</p>
    </header>
    <nav class="recovery-links" aria-label="Find your way back">
      <a class="text-link" href="/">Back home</a>
      <a class="text-link" href="/notes">Browse notes</a>
    </nav>
  </main>
</Layout>
