---
import Layout from "./Layout.astro";
import CodeCopy from "../components/CodeCopy.astro";
import ArticleHeadingLinks from "../components/ArticleHeadingLinks.astro";
import BirthdayConfetti from "../components/BirthdayConfetti.astro";
const { frontmatter, previous, next, minutes } = Astro.props;
const dateFormat = new Intl.DateTimeFormat("en", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<Layout
  title={`${frontmatter.title} — cedric ahenkorah`}
  description={frontmatter.description ?? undefined}
  article
>
  {frontmatter.birthdayConfetti && <BirthdayConfetti />}
  <main id="main" class="shell article-page">
    <a class="text-link back-link" href="/notes">Back to notes</a>
    <article>
      <header class="article-header">
        <h1>{frontmatter.title}</h1>
        <div class="article-meta">
          <time datetime={frontmatter.pubDate.toISOString()}
            >{dateFormat.format(frontmatter.pubDate)}</time
          >
          <span aria-hidden="true">·</span>
          <span>{minutes} min read</span>
        </div>
      </header>
      <div class="prose"><slot /></div>
      <nav class="article-navigation" aria-label="Continue reading">
        {
          previous && (
            <a class="adjacent-note previous-note" href={`/posts/${previous.id}`} rel="prev">
              <span class="note-direction">previous note</span>
              <span>{previous.data.title}</span>
            </a>
          )
        }
        {
          next && (
            <a class="adjacent-note next-note" href={`/posts/${next.id}`} rel="next">
              <span class="note-direction">next note</span>
              <span>{next.data.title}</span>
            </a>
          )
        }
        <a class="text-link all-notes" href="/notes">back to notes</a>
      </nav>
    </article>
    <CodeCopy />
    <ArticleHeadingLinks />
  </main>
</Layout>
