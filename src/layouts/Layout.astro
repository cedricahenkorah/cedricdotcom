---
import "../styles/tailwind.css";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";
interface Props {
  title: string;
  description?: string;
  article?: boolean;
  showFooter?: boolean;
}
const {
  title,
  description = "cedric ahenkorah builds backend systems, web applications, and developer tools.",
  article = false,
  showFooter = true,
} = Astro.props;
const displayTitle = article ? title : title.toLowerCase();
const canonical = new URL(Astro.url.pathname, "https://cedricdotcom.com");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://cedricdotcom.com/my-notion-face-portrait.png"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={displayTitle} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://cedricdotcom.com/my-notion-face-portrait.png"
    />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#161615"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Lora:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{displayTitle}</title>
    <script is:inline>
      (() => {
        let saved;
        try {
          saved = localStorage.getItem("theme");
        } catch {}
        const dark =
          saved === "dark" ||
          (saved !== "light" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Navbar />
    <slot />
    {showFooter && <Footer />}
    <Analytics />
  </body>
</html>
